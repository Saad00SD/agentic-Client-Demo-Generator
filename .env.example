# Optional published port for Docker Compose
APP_PORT=3000

# Backend only. Never use NEXT_PUBLIC_ for secret keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LangSmith tracing (backend only)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=demo-generator-v3
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional for keys that belong to multiple workspaces
# LANGSMITH_WORKSPACE_ID=
APP_ENV=development
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
# Include every preview asset request instead of just page visits and downloads
LANGSMITH_TRACE_ASSETS=false
# Optional USD prices per million tokens for GROQ_MODEL. Leave unset to use
# LangSmith's model pricing table; no prices are guessed by this application.
# GROQ_INPUT_COST_PER_MILLION=
# GROQ_OUTPUT_COST_PER_MILLION=

# Used only when the browser accesses the backend across origins
CORS_ORIGINS=http://localhost:3000
